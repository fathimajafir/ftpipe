{
  "run_name": "demo-offline",
  "seed": 7,
  "dry_run": true,
  "data": {
    "train": "data/raw/train.jsonl",
    "eval": "data/raw/eval.jsonl",
    "val_fraction": 0.15,
    "max_chars": 8000
  },
  "finetune": {
    "targets": ["mock"],
    "hyperparameters": {"epochs": 2, "batch_size": 4, "learning_rate": 0.0001}
  },
  "evaluate": {
    "models": ["mock:base", "mock:ft"],
    "metrics": ["exact_match", "token_f1", "rouge_l"],
    "limit": 0,
    "judge": {"enabled": true, "provider": "mock", "model": "judge", "criteria": ["correctness", "clarity"]}
  }
}
